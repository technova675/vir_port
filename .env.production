# Read by `next build`. The build now runs here rather than on a host, so the
# platform variables the metadata used to rely on (Netlify's URL, Vercel's own)
# are not set by anyone — without this, metadataBase falls back to
# http://localhost:3010 and the exported HTML ships a dead og:image.
#
# Public and non-secret: it is the site's own address, and it is inlined into
# the client bundle by design. Committed for exactly that reason.
NEXT_PUBLIC_SITE_URL=https://thevirofficial.com
