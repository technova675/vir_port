# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Opted in: holds only the public site URL, which `next build` inlines into the
# exported HTML. Without it in the repo, a build elsewhere bakes a localhost
# og:image. Nothing secret goes in this file.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
