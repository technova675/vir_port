# Copied verbatim into out/ by `next build` and read by the host's
# Apache/LiteSpeed. This replaces the `headers()` block that next.config.mjs
# used to carry: `output: "export"` has no server, so that block would be
# silently ignored.

# The hero crops are the largest thing on the page and the first thing
# painted. Without this they are served with `max-age=0, must-revalidate`,
# which costs a conditional request on every repeat view.
#
# NOT `immutable`: these filenames are not content-hashed. A 30-day window
# with stale-while-revalidate means a re-export is picked up in the
# background rather than being pinned for a year.
<IfModule mod_headers.c>
  <LocationMatch "^/hero/">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </LocationMatch>

  # Next writes these under a build-id path and changes the path whenever the
  # contents change, so they are safe to pin hard.
  <LocationMatch "^/_next/static/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>
</IfModule>

# Next writes the generated share cards as extensionless files (out/opengraph-image,
# out/twitter-image), so Apache has no extension to infer a type from and would
# hand them out as text/plain or octet-stream. Crawlers reject that, which costs
# the preview on every share.
<IfModule mod_mime.c>
  <Files "opengraph-image">
    ForceType image/png
  </Files>
  <Files "twitter-image">
    ForceType image/png
  </Files>
</IfModule>
